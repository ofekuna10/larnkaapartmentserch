# ---------------------------------------------------------------------------
# SocialAgent AI — copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_ENV=development           # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# Comma-separated list, or * in development only.
CORS_ORIGINS=http://localhost:3000

# --- Security ---------------------------------------------------------------
# openssl rand -hex 32
SECRET_KEY=change-me-32-byte-hex
ACCESS_TOKEN_TTL_MINUTES=60
# Fernet key used to encrypt stored OAuth tokens at rest:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- LLM providers ----------------------------------------------------------
LLM_PROVIDER=anthropic        # anthropic | openai | echo (offline stub)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Adaptive thinking; the retired `budget_tokens` form is rejected by current models.
LLM_ADAPTIVE_THINKING=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_MAX_TOKENS=16000
# OpenAI adapter only — Anthropic calls send no sampling parameters.
LLM_TEMPERATURE=0.4
LLM_TIMEOUT_SECONDS=90

# --- PostgreSQL / Supabase --------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/social_agent
DATABASE_POOL_SIZE=10
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Vector DB (brand voice + historical memory) ----------------------------
VECTOR_BACKEND=memory         # qdrant | memory (in-process stub)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=brand_voice
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Meta Graph API (Instagram + Facebook) ----------------------------------
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v20.0
META_REDIRECT_URI=http://localhost:8000/api/v1/auth/meta/callback
META_WEBHOOK_VERIFY_TOKEN=

# --- YouTube Data API v3 ----------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_API_KEY=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/auth/youtube/callback

# --- TikTok Content Posting API ---------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/v1/auth/tiktok/callback

# --- Pipeline behaviour -----------------------------------------------------
MAX_VALIDATION_RETRIES=2
AUTO_PUBLISH_ENABLED=false    # false => everything goes to human approval
MIN_BRAND_VOICE_SCORE=0.75
MIN_SAFETY_SCORE=0.90
ANALYTICS_LOOKBACK_DAYS=90
